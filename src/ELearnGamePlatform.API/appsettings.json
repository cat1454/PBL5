  "OllamaSettings": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3:4b",
    "AnalysisModel": "qwen3:4b",
    "GenerationModel": "qwen3:4b",
    "VerificationModel": "qwen3:4b",
    "TimeoutSeconds": 300, 
    "KeepAlive": "30m",
    "EnableTimingLogs": true,
    "Temperature": 0.4,
    "AnalysisTemperature": 0.2,
    "GenerationTemperature": 0.5,
    "VerificationTemperature": 0.1
},
  "LocalLlmSettings": {
    "ContextWindowTokens": 32000,
    "ReservedOutputTokens": 3000,
    "ReservedInstructionTokens": 1200,
    "SafetyMarginTokens": 1200,
    "Profile": "quality",
    "TargetChunkTokens": 700,
    "MaxChunkTokens": 1100,
    "ChunkOverlapTokens": 80,
    "TargetInputBudgetFillRatio": 0.80,
    "IncludeFullSelectedChunkText": false,
    "EnableAnalysisRefine": true,
    "AllowLowConfidenceCalculationQuestions": false,
    "MinTextLengthForAIRefine": 1500,
    "MinCoverageChunksForAIRefine": 3
  },
  "OcrSettings": {
    "DefaultPdfDpi": 300,
    "RetryPdfDpi": 400,
    "MinAcceptablePageQuality": 75,
    "RetryThreshold": 55,
    "MaxRetryPerPage": 2,
    "EnableQualityProfile": true,
    "EnablePreprocessingFallback": true,
    "EnableCropBorder": true,
    "EnableThresholdFallback": true,
    "MaxPreprocessingVariantsPerPage": 3,
    "MinPreprocessingGainThreshold": 3,
    "MaxLowGainPreprocessingAttemptsPerDocument": 3,
    "EnableTextLayerQualityCalibration": true,
    "ExcludeCoverPagesFromQualityAverage": true,
    "EnableVietnameseTextNormalization": true,
    "MinBodyPageQualityForAccepted": 60,
    "MinBodyPageQualityForNeedsReview": 45
  },
  "DocumentUnderstanding": {
    "Enabled": false,
    "EnableLayoutAnalysis": false,
    "EnableVisionAnalysis": false,
    "EnableTableExtraction": false,
    "FallbackToLegacyOcr": true,
    "EnforceGenerationGate": false,
    "ShowGenerationWarnings": true,
    "MinAutoGenerateConfidence": 0.85,
    "MinReviewRequiredConfidence": 0.65,
    "MinStrongWarningConfidence": 0.45,
    "VisionModel": "llama3.2-vision:11b",
    "VisionTimeoutSeconds": 120,
    "MaxVisionPagesPerDocument": 5,
    "MaxVisionRegionsPerPage": 3
  },
  "FileUpload": {
    "MaxFileSizeInMB": 50,
    "AllowedExtensions": [".pdf", ".docx", ".png", ".jpg", ".jpeg"]
  },
  "ImagePipeline": {
    "Enabled": true,
    "ModelTier": "low",
    "EnableLocalImageReview": false,
    "DownloadAssetsLocally": true,
    "AssetStorageRoot": "uploads/slide-assets",
    "MaxCandidatesToRerank": 8,
    "MaxCandidatesToPersist": 4,
    "PreferredAspectRatio": "16:9",
    "LicensePolicy": "license-safe",
    "Planning": {
      "Provider": "ollama",
      "Model": "qwen3:4b",
      "Temperature": 0.2,
      "MaxPromptChars": 800,
      "TimeoutSeconds": 90
    },
    "Rerank": {
      "Provider": "siglip2",
      "Model": "google/siglip2-base-patch16-224",
      "TopKBeforeReview": 8,
      "FinalShortlistCount": 4,
      "PreferGpu": true
    },
    "Review": {
      "Provider": "ollama-vl",
      "Model": "qwen3:4b",
      "TimeoutSeconds": 120,
      "MaxImagesPerSlide": 4,
      "MaxParallelSlides": 1
    },
    "Generation": {
      "Provider": "openai",
      "Model": "gpt-image-1.5",
      "UseOnlyAsFallback": true,
      "TimeoutSeconds": 120,
      "Quality": "high",
      "Size": "1536x1024"
    },
    "WebSources": {
      "Enabled": true,
      "MaxResultsPerQuery": 20,
      "MaxDownloadsPerSlide": 8,
      "MinAcceptableScore": 0.86,
      "AllowedDomains": [
        "commons.wikimedia.org",
        "unsplash.com",
        "pexels.com"
      ]
    }
  }
}
