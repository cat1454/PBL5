{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ELearnGameDB;Username=postgres;Password=123qwe!@#;SslMode=disable"
  },
  "OllamaSettings": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:7b",
    "AnalysisModel": "qwen2.5:7b",
    "GenerationModel": "qwen2.5:7b",
    "VerificationModel": "qwen2.5:7b",
    "TimeoutSeconds": 300, 
    "KeepAlive": "30m",
    "EnableTimingLogs": true,
    "Temperature": 0.4,
    "AnalysisTemperature": 0.2,
    "GenerationTemperature": 0.5,
    "VerificationTemperature": 0.1
